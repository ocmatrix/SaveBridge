# /etc/savebridge-watcher/rpc.env — root:root 0600. RPC URLs only.
# WANTOS: rpc3's own node on loopback = read source AND the only pause() write endpoint (port: confirm on rpc3)
WANTOS_RPC3_LOCAL=http://127.0.0.1:8545
# READ-ONLY cross-check sources (user authorisation 2026-11-02): low frequency, never written to (enforced)
WANTOS_RPC1_READONLY=https://rpc.wantos.io
WANTOS_RPC2_READONLY=https://rpc2.wantos.io
# BSC: three providers DIFFERENT from the payout server's where possible (watcher must not share data sources)
BSC_RPC_1=https://<provider-x>/<key>
BSC_RPC_2=https://<provider-y>/<key>
BSC_RPC_3=https://<provider-z>/<key>

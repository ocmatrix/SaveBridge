{
  "wantos": {
    "chainId": 13555,
    "startBlock": 0,
    "primaryRpcUrlEnv": "WANTOS_RPC3",
    "writeRpcUrlEnv": "WANTOS_RPC3",
    "crossCheckRpcUrlEnvs": ["WANTOS_RPC1_READONLY", "WANTOS_RPC2_READONLY"],
    "bridgeAddress": "0x00000000000000000000000000000000000b0001",
    "confirmations": 6
  },
  "bsc": {
    "chainId": 56,
    "rpcUrlEnvs": ["BSC_RPC_1", "BSC_RPC_2", "BSC_RPC_3"],
    "writeRpcUrlEnv": "BSC_RPC_1",
    "bridgeAddress": "0x00000000000000000000000000000000000b0001",
    "startBlock": 0
  },
  "signer": {
    "kind": "local-keystore",
    "wantos": { "keystorePath": "/var/lib/savebridge/keystore/relayer-wantos.json", "passphraseCredential": "relayer-wantos-pass", "address": "0x0000000000000000000000000000000000000A01" },
    "bsc": { "keystorePath": "/var/lib/savebridge/keystore/relayer-bsc.json", "passphraseCredential": "relayer-bsc-pass", "address": "0x0000000000000000000000000000000000000A02" }
  },
  "submitter": { "kind": "local-keystore", "keystorePath": "/var/lib/savebridge/keystore/submitter.json", "passphraseCredential": "submitter-pass", "address": "0x0000000000000000000000000000000000000A03" },
  "rpcNodes": { "WANTOS_RPC3": "rpc3", "WANTOS_RPC1_READONLY": "rpc1", "WANTOS_RPC2_READONLY": "rpc2" },

  "alerts": { "telegram": { "botTokenCredential": "telegram-bot-token", "chatIdCredential": "telegram-chat-id" }, "requireTelegram": true, "logFile": "/var/log/savebridge/alerts.jsonl" },
  "db": { "urlEnv": "RELAYER_DATABASE_URL" },
  "api": { "host": "127.0.0.1", "port": 8080, "corsOrigins": ["https://bridge.wanto.pro"] },
  "poll": { "intervalMs": 5000, "rescanBlocks": 100, "maxBlockRange": 2000 },
  "tx": { "replaceByFee": true, "stuckAfterMs": 120000, "feeBumpPercent": 15, "maxFeeBumps": 5 },
  "gas": { "wantosMinBalanceWei": "1000000000000000000", "bscMinBalanceWei": "50000000000000000" },
  "heartbeat": { "intervalMs": 60000, "staleAfterMs": 300000, "urlCredential": "heartbeat-url" }

# /etc/savebridge/rpc.env — root:root 0600. RPC URLs only (they may embed provider API keys).
# WANTOS: rpc3 is the ONLY read primary and the ONLY write endpoint.
WANTOS_RPC3=https://rpc3.wantos.io
# rpc1 / rpc2: READ-ONLY cross-check (user authorisation 2026-11-02). Never used for writes (enforced).
WANTOS_RPC1_READONLY=https://rpc.wantos.io
WANTOS_RPC2_READONLY=https://rpc2.wantos.io
# BSC: three different providers (BSC_RPC_1 is also the broadcast endpoint)
BSC_RPC_1=https://<provider-a>/<key>
BSC_RPC_2=https://<provider-b>/<key>
BSC_RPC_3=https://<provider-c>/<key>
# The WATCHER's BSC provider host names (rpc3's rpc.env BSC_RPC_*), comma-separated, host names only.
# Startup refuses if any of our BSC providers (same registrable domain) appears here, or if this is empty.
PEER_BSC_RPC_HOSTS=<watcher-provider-x-host>,<watcher-provider-y-host>,<watcher-provider-z-host>

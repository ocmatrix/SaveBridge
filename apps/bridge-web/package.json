{
  "name": "@bridge/bridge-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode placeholder && node scripts/check-dist.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build:prod": "vite build --mode production && node scripts/check-dist.mjs --real",
    "build:testnet": "vite build --mode testnet --outDir dist-testnet && node scripts/check-dist.mjs --real --testnet --mode=testnet --dist=dist-testnet"
  },
  "dependencies": {
    "@bridge/abi": "workspace:*",
    "@tanstack/react-query": "^5.105.0",
    "@wagmi/connectors": "^8.2.2",
    "@walletconnect/ethereum-provider": "^2.26.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.13",
    "wagmi": "^3.7.9"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}

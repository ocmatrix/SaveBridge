# Build-time configuration for bridge.wanto.pro (Vite inlines VITE_* into the bundle; nothing here is secret).
# Copy to .env.production.local, fill in the real values, then: pnpm --filter @bridge/bridge-web build:prod
# Contract addresses are deliberately NOT in the source code (DESIGN §8.1); they come only from here.

# --- WANTOS ---
VITE_WANTOS_CHAIN_ID=13555
VITE_WANTOS_CHAIN_NAME=WANTOS
# native gas token symbol shown by wallet_addEthereumChain (confirm with the chain team)
VITE_WANTOS_NATIVE_SYMBOL=WANT
VITE_WANTOS_RPC_URL=https://rpc.wantos.io
VITE_WANTOS_EXPLORER_URL=https://scan.wantos.io
VITE_WANTOS_BRIDGE=0x<WANTOS bridge proxy address>
VITE_WANTOS_USDT=0x<WANTOS-USDT token address>
# bridge deployment block (event scan start)
VITE_WANTOS_FROM_BLOCK=0

# --- BSC ---
VITE_BSC_CHAIN_ID=56
VITE_BSC_CHAIN_NAME=BNB Smart Chain
VITE_BSC_NATIVE_SYMBOL=BNB
VITE_BSC_RPC_URL=https://<BSC RPC endpoint>
VITE_BSC_EXPLORER_URL=https://bscscan.com
VITE_BSC_BRIDGE=0x<BSC vault proxy address (same as WANTOS bridge, DESIGN §5.1)>
VITE_BSC_USDT=0x<BSC-USDT token address>
VITE_BSC_FROM_BLOCK=0

# --- optional ---
# relayer read-only API base (PR-3), e.g. https://api.example.org — leave empty to read status from chain only
VITE_RELAYER_API=
# WalletConnect v2 project id (desktop QR); leave empty to offer injected wallets only
VITE_WC_PROJECT_ID=
# max blocks scanned backwards for the user's events when the relayer API is not configured
VITE_LOG_LOOKBACK_BLOCKS=50000

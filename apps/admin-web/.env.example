# Public values only (they end up in the bundle). Never put keys here.
VITE_BSC_CHAIN_ID=56
VITE_BSC_RPC_URL=https://<bsc rpc>
VITE_BSC_BRIDGE=0x<bridge proxy, same on both chains>
VITE_BSC_FROM_BLOCK=<deployment block>
VITE_WANTOS_CHAIN_ID=13555
VITE_WANTOS_RPC_URL=https://rpc.wantos.io
VITE_WANTOS_BRIDGE=0x<bridge proxy>
VITE_WANTOS_FROM_BLOCK=<deployment block>
# Same-origin Worker route, e.g. https://admin.wanto.pro/api (leave empty until the relayer admin API exists)
VITE_ADMIN_API=
VITE_SIWE_DOMAIN=admin.wanto.pro
